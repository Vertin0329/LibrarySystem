####### Build rules

first: all
all: Makefile.Debug  debug/LibrarySystem.exe

debug/LibrarySystem.exe: C:/Qt/6.11.1/mingw_64/lib/libQt6Widgets.a C:/Qt/6.11.1/mingw_64/lib/libQt6Gui.a C:/Qt/6.11.1/mingw_64/lib/libQt6Sql.a C:/Qt/6.11.1/mingw_64/lib/libQt6Network.a C:/Qt/6.11.1/mingw_64/lib/libQt6Core.a C:/Qt/6.11.1/mingw_64/lib/libQt6EntryPoint.a ui_accountverifydialog.h ui_addnewdialog.h ui_bookborrowconfirmdialog.h ui_bookrenewdialog.h ui_bookreturndialog.h ui_bookwindow_librarian.h ui_bookwindow_student.h ui_deletebookdialog.h ui_filterbookforlibrariandialog.h ui_filterdialog.h ui_filterlogforuserdialog.h ui_filteruserforlibrariandialog.h ui_loginwindow.h ui_logoutconfirmdialog.h $(OBJECTS) 
	$(LINKER) $(LFLAGS) -o $(DESTDIR_TARGET) @debug/object_script.LibrarySystem.Debug $(LIBS)

qmake: FORCE
	@$(QMAKE) -o Makefile.Debug ../../LibrarySystem.pro -spec win32-g++ CONFIG+=debug CONFIG+=qml_debug

qmake_all: FORCE

