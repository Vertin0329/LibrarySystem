TARGET         = LibrarySystem.exe
DESTDIR_TARGET = release/LibrarySystem.exe

####### Build rules

first: all
all: Makefile.Release  release/LibrarySystem.exe

release/LibrarySystem.exe: C:/Qt/6.11.1/mingw_64/lib/libQt6Widgets.a C:/Qt/6.11.1/mingw_64/lib/libQt6Gui.a C:/Qt/6.11.1/mingw_64/lib/libQt6Sql.a C:/Qt/6.11.1/mingw_64/lib/libQt6Network.a C:/Qt/6.11.1/mingw_64/lib/libQt6Core.a C:/Qt/6.11.1/mingw_64/lib/libQt6EntryPoint.a ui_accountverifydialog.h ui_addnewdialog.h ui_bookborrowconfirmdialog.h ui_bookrenewdialog.h ui_bookreturndialog.h ui_bookwindow_librarian.h ui_bookwindow_student.h ui_deletebookdialog.h ui_filterbookforlibrariandialog.h ui_filterdialog.h ui_filteruserforlibrariandialog.h ui_loginwindow.h $(OBJECTS) 
	$(LINKER) $(LFLAGS) -o $(DESTDIR_TARGET) @release/object_script.LibrarySystem.Release $(LIBS)

qmake: FORCE
	@$(QMAKE) -o Makefile.Release ../../LibrarySystem.pro -spec win32-g++ CONFIG+=qtquickcompiler

qmake_all: FORCE

